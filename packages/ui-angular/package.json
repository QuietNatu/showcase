{
  "name": "@natu/ui-angular",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./components/*": {
      "types": "./src/lib/components/*/index.ts",
      "default": "./src/lib/components/*/index.ts"
    }
  },
  "scripts": {
    "format": "eslint . --fix --report-unused-disable-directives --no-warn-ignored --max-warnings 0",
    "lint": "eslint . --report-unused-disable-directives --no-warn-ignored --max-warnings 0",
    "preview": "vite preview --outDir ./dist/browser",
    "storybook": "ng run lib:storybook",
    "storybook:build": "ng run lib:build-storybook",
    "storybook:preview": "vite preview --port 6113 --outDir ./storybook-static",
    "test": "ng test --coverage",
    "test:watch": "cross-env TEST_DEBUG=1 ng test --watch"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "catalog:",
    "@analogjs/vitest-angular": "catalog:",
    "@angular-devkit/architect": "catalog:",
    "@angular-devkit/core": "catalog:",
    "@angular/build": "catalog:",
    "@angular/cdk": "catalog:",
    "@angular/cli": "catalog:",
    "@angular/common": "catalog:",
    "@angular/compiler": "catalog:",
    "@angular/compiler-cli": "catalog:",
    "@angular/core": "catalog:",
    "@angular/forms": "catalog:",
    "@angular/platform-browser": "catalog:",
    "@angular/router": "catalog:",
    "@compodoc/compodoc": "catalog:",
    "@natu/axe": "workspace:^",
    "@natu/browserslist-config-shared": "workspace:^",
    "@natu/eslint-config-shared": "workspace:^",
    "@natu/stories": "workspace:^",
    "@natu/styles": "workspace:^",
    "@natu/tsconfig": "workspace:^",
    "@playwright/test": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/angular-vite": "catalog:",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "cross-env": "catalog:",
    "eslint": "catalog:",
    "rxjs": "catalog:",
    "sass-embedded": "catalog:",
    "storybook": "catalog:",
    "tslib": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-angular": "catalog:"
  },
  "peerDependencies": {
    "@angular/cdk": "catalog:",
    "@angular/common": "catalog:",
    "@angular/core": "catalog:",
    "@angular/forms": "catalog:",
    "@angular/platform-browser": "catalog:",
    "@angular/router": "catalog:",
    "@natu/styles": "workspace:^",
    "rxjs": "catalog:",
    "tslib": "catalog:"
  }
}
