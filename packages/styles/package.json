{
  "name": "@natu/styles",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    "./assets/*": "./src/assets/*",
    "./stylesheets/utils": {
      "sass": "./src/stylesheets/utils/_index.scss"
    },
    "./stylesheets/styles": {
      "sass": "./dist/stylesheets/styles.scss"
    },
    "./stylesheets/tokens/rotom-dark": {
      "sass": "./dist/tokens/_rotom-dark.scss"
    },
    "./stylesheets/tokens/rotom": {
      "sass": "./dist/tokens/_rotom.scss"
    },
    "./stylesheets/tokens/smeargle-dark": {
      "sass": "./dist/tokens/_smeargle-dark.scss"
    },
    "./stylesheets/tokens/smeargle": {
      "sass": "./dist/tokens/_smeargle.scss"
    }
  },
  "scripts": {
    "build": "pnpm build:tokens && pnpm build:stylesheets",
    "build:tokens": "tsx ./src/build-tokens.ts",
    "build:stylesheets": "sass --pkg-importer=node ./src/stylesheets/styles.scss ./dist/stylesheets/styles.scss",
    "lint": "tsc --noEmit && eslint . --report-unused-disable-directives --no-warn-ignored --max-warnings 0",
    "storybook": "storybook dev -p 6900",
    "storybook:build": "storybook build",
    "storybook:preview": "vite preview --port 6900 --outDir ./storybook-static",
    "test": "vitest run"
  },
  "dependencies": {
    "modern-normalize": "catalog:"
  },
  "devDependencies": {
    "@natu/axe": "workspace:^",
    "@natu/eslint-config-shared": "workspace:^",
    "@natu/stories": "workspace:^",
    "@natu/tsconfig": "workspace:^",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "colorjs.io": "catalog:",
    "eslint": "catalog:",
    "happy-dom": "catalog:",
    "picocolors": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sass-embedded": "catalog:",
    "storybook": "catalog:",
    "style-dictionary": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
