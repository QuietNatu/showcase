{
  "name": "@natu/ui-react",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./components/*": {
      "types": "./src/lib/components/*/index.ts",
      "default": "./src/lib/components/*/index.ts"
    },
    "./utils/context": {
      "types": "./src/lib/utils/context.ts",
      "default": "./src/lib/utils/context.ts"
    }
  },
  "scripts": {
    "lint": "tsc --noEmit && eslint . --report-unused-disable-directives --no-warn-ignored --max-warnings 0",
    "storybook": "storybook dev -p 6013",
    "storybook:build": "storybook build",
    "storybook:preview": "vite preview --port 6013 --outDir ./storybook-static",
    "test": "vitest run --coverage",
    "test:watch": "vitest --browser.headless=false"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.0.0",
    "@natu/styles": "workspace:^",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@base-ui/react": "1.4.1",
    "@eslint/js": "9.39.4",
    "@natu/axe": "workspace:^",
    "@natu/eslint-config-shared": "workspace:^",
    "@natu/stories": "workspace:^",
    "@natu/styles": "workspace:^",
    "@natu/tsconfig": "workspace:^",
    "@playwright/test": "1.59.1",
    "@storybook/addon-a11y": "10.3.6",
    "@storybook/addon-docs": "10.3.6",
    "@storybook/react-vite": "10.3.6",
    "@types/node": "24.12.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react-swc": "4.3.0",
    "@vitest/browser-playwright": "4.0.16",
    "@vitest/coverage-v8": "4.0.16",
    "cross-env": "10.1.0",
    "eslint": "9.39.4",
    "globals": "17.5.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "storybook": "10.3.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.1",
    "vite": "7.3.2",
    "vitest": "4.0.16",
    "vitest-browser-react": "2.2.0"
  }
}
