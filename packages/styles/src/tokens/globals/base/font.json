{
  "font": {
    "family": {
      "$type": "fontFamily",
      "heading": {
        "$value": "Montserrat, Helvetica, Arial, sans-serif"
      },
      "regular": {
        "$value": "-apple-system, BlinkMacSystemFont, avenir next, avenir, segoe ui, helvetica neue, Adwaita Sans, Cantarell, Ubuntu, roboto, noto, helvetica, arial, sans-serif"
      }
    },
    "size": {
      "$type": "dimension",

      "1": { "$value": { "value": 12, "unit": "px" } },
      "2": { "$value": { "value": 14, "unit": "px" } },
      "3": { "$value": { "value": 16, "unit": "px" } },
      "4": { "$value": { "value": 18, "unit": "px" } },
      "5": { "$value": { "value": 20, "unit": "px" } },
      "6": { "$value": { "value": 24, "unit": "px" } },
      "7": { "$value": { "value": 28, "unit": "px" } },
      "8": { "$value": { "value": 32, "unit": "px" } },
      "9": { "$value": { "value": 36, "unit": "px" } },
      "10": { "$value": { "value": 42, "unit": "px" } },
      "11": { "$value": { "value": 48, "unit": "px" } },
      "12": { "$value": { "value": 54, "unit": "px" } },
      "13": { "$value": { "value": 60, "unit": "px" } },
      "14": { "$value": { "value": 68, "unit": "px" } },
      "15": { "$value": { "value": 76, "unit": "px" } },
      "16": { "$value": { "value": 84, "unit": "px" } },
      "17": { "$value": { "value": 92, "unit": "px" } }
    },
    "weight": {
      "$type": "fontWeight",
      "light": {
        "$value": "300"
      },
      "regular": {
        "$value": "400"
      },
      "strong": {
        "$value": "600"
      }
    }
  }
}
