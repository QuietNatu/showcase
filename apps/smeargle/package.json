{
  "name": "smeargle",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build && tsc --noEmit",
    "build:api": "orval --config ./orval.config.ts",
    "dev": "vite",
    "format": "eslint . --fix --report-unused-disable-directives --no-warn-ignored --max-warnings 0",
    "lint": "tsc --noEmit && eslint . --report-unused-disable-directives --no-warn-ignored --max-warnings 0",
    "preview": "vite preview",
    "start": "node src/app/server/start-server.ts",
    "storybook": "storybook dev -p 6003",
    "storybook:build": "storybook build",
    "storybook:build:test": "storybook build --test",
    "storybook:preview": "http-server -c-1 ./storybook-static --silent",
    "test": "vitest run --coverage",
    "test:integration": "playwright test --config tests/integration/playwright.config.ts",
    "test:integration:start-mocks": "tsx ./tests/integration/src/server/server.ts",
    "test:vrt": "playwright test --config tests/vrt/playwright.config.ts",
    "test:vrt:report": "playwright show-report vrt/report --port 6004",
    "test:vrt:update": "pnpm vrt --update-snapshots",
    "test:watch": "vitest --browser.headless=false"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@natu/api-contracts": "workspace:^",
    "@natu/styles": "workspace:^",
    "@natu/ui-react": "workspace:^",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-devtools": "catalog:",
    "@tanstack/react-start": "catalog:",
    "axios": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "srvx": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@faker-js/faker": "catalog:",
    "@msw/data": "catalog:",
    "@mswjs/http-middleware": "catalog:",
    "@natu/axe": "workspace:^",
    "@natu/browserslist-config-shared": "workspace:^",
    "@natu/eslint-config-shared": "workspace:^",
    "@natu/orval": "workspace:^",
    "@natu/stories": "workspace:^",
    "@natu/tsconfig": "workspace:^",
    "@natu/vrt": "workspace:*",
    "@playwright/test": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "browserslist-to-esbuild": "catalog:",
    "cross-env": "catalog:",
    "eslint": "catalog:",
    "express": "catalog:",
    "globals": "catalog:",
    "http-server": "catalog:",
    "msw": "catalog:",
    "orval": "catalog:",
    "playwright": "catalog:",
    "sass-embedded": "catalog:",
    "storybook": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "catalog:"
  }
}
