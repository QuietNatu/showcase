{
  "name": "showcase",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "turbo run build",
    "build:api": "turbo run build:api",
    "dev": "turbo run dev",
    "format": "turbo run format && pnpm run format:stylelint && pnpm run format:prettier",
    "format:prettier": "prettier . --write",
    "format:stylelint": "stylelint --fix '{apps,packages}/*/src/**/*.{css,scss}'",
    "lint": "turbo run lint && pnpm lint:lslint && pnpm lint:stylelint && pnpm run lint:prettier",
    "lint:eslint": "turbo run lint",
    "lint:lslint": "ls-lint",
    "lint:prettier": "prettier . --check",
    "lint:stylelint": "stylelint '{apps,packages}/*/src/**/*.{css,scss}' 'packages/styles/dist/**/*.{css,scss}'",
    "postinstall": "npx msw init",
    "preflight-check": "node scripts/preflight-check.ts",
    "prepare": "husky",
    "renovate:validate": "pnpm dlx --package=renovate --package=re2 -- renovate-config-validator --strict",
    "start": "turbo run start",
    "storybook": "turbo run storybook",
    "storybook:build": "turbo run storybook:build",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:integration": "turbo run test:integration"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@ls-lint/ls-lint": "catalog:",
    "@natu/browserslist-config-shared": "workspace:^",
    "@natu/tsconfig": "workspace:^",
    "@types/node": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "msw": "catalog:",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-css-modules": "catalog:",
    "stylelint-config-standard-scss": "catalog:",
    "stylelint-declaration-block-no-ignored-properties": "catalog:",
    "stylelint-gamut": "catalog:",
    "stylelint-no-unsupported-browser-features": "catalog:",
    "stylelint-order": "catalog:",
    "stylelint-plugin-logical-css": "catalog:",
    "stylelint-scss": "catalog:",
    "turbo": "catalog:",
    "vitest": "catalog:"
  },
  "msw": {
    "workerDirectory": [
      "apps/rotom/public",
      "apps/smeargle/public"
    ]
  }
}
