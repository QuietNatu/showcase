{
  "name": "showcase",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "turbo run build",
    "build:api": "turbo run build:api",
    "dev": "turbo run dev",
    "format": "turbo run format && pnpm run format:stylelint && pnpm run format:prettier",
    "format:prettier": "prettier . --write",
    "format:stylelint": "stylelint --fix '{apps,packages}/*/src/**/*.{css,scss}'",
    "lint": "turbo run lint && pnpm lint:lslint && pnpm lint:stylelint && pnpm run lint:prettier",
    "lint:eslint": "turbo run lint",
    "lint:lslint": "ls-lint",
    "lint:prettier": "prettier . --check",
    "lint:stylelint": "stylelint '{apps,packages}/*/src/**/*.{css,scss}' 'packages/styles/dist/**/*.{css,scss}'",
    "postinstall": "npx msw init",
    "preflight-check": "node scripts/preflight-check.ts",
    "prepare": "husky",
    "renovate:validate": "pnpm dlx --package=renovate -- renovate-config-validator",
    "start": "turbo run start",
    "storybook": "turbo run storybook",
    "storybook:build": "turbo run storybook:build",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:integration": "turbo run test:integration"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "@ls-lint/ls-lint": "2.3.1",
    "@natu/browserslist-config-shared": "workspace:^",
    "@natu/tsconfig": "workspace:^",
    "@types/node": "24.12.2",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "msw": "2.14.3",
    "playwright": "1.59.1",
    "prettier": "3.9.6",
    "stylelint": "17.11.0",
    "stylelint-config-css-modules": "4.6.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-declaration-block-no-ignored-properties": "3.0.0",
    "stylelint-gamut": "2.0.0",
    "stylelint-no-unsupported-browser-features": "8.1.1",
    "stylelint-order": "8.1.1",
    "stylelint-plugin-logical-css": "2.1.0",
    "stylelint-scss": "7.0.0",
    "turbo": "2.9.9",
    "vitest": "4.1.5"
  },
  "msw": {
    "workerDirectory": [
      "apps/rotom/public",
      "apps/smeargle/public"
    ]
  }
}
