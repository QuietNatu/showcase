{
  "name": "smeargle",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build && tsc --noEmit",
    "build:api": "orval --config ./orval.config.ts",
    "dev": "vite",
    "format": "eslint . --fix --report-unused-disable-directives --no-warn-ignored --max-warnings 0",
    "lint": "tsc --noEmit && eslint . --report-unused-disable-directives --no-warn-ignored --max-warnings 0",
    "preview": "vite preview",
    "start": "node src/app/server/start-server.ts",
    "storybook": "storybook dev -p 6003",
    "storybook:build": "storybook build",
    "storybook:preview": "vite preview --port 6003 --outDir ./storybook-static",
    "test": "vitest run --coverage",
    "test:watch": "vitest --browser.headless=false",
    "test:integration": "playwright test --config tests/integration/playwright.config.ts",
    "test:integration:start-mocks": "tsx ./tests/integration/src/server/server.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.4.1",
    "@natu/styles": "workspace:^",
    "@natu/ui-react": "workspace:^",
    "@tanstack/react-router": "1.157.17",
    "@tanstack/react-router-devtools": "1.157.17",
    "@tanstack/react-start": "1.157.17",
    "axios": "1.15.2",
    "effect": "3.21.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "srvx": "0.11.15",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@faker-js/faker": "10.4.0",
    "@msw/data": "1.1.5",
    "@mswjs/http-middleware": "0.10.3",
    "@natu/axe": "workspace:^",
    "@natu/browserslist-config-shared": "workspace:^",
    "@natu/eslint-config-shared": "workspace:^",
    "@natu/orval": "workspace:^",
    "@natu/stories": "workspace:^",
    "@natu/tsconfig": "workspace:^",
    "@playwright/test": "1.57.0",
    "@storybook/addon-a11y": "10.3.6",
    "@storybook/addon-docs": "10.3.6",
    "@storybook/react-vite": "10.3.6",
    "@types/express": "5.0.6",
    "@types/node": "24.12.2",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react-swc": "4.2.2",
    "@vitest/browser-playwright": "4.0.16",
    "@vitest/coverage-v8": "4.0.16",
    "browserslist-to-esbuild": "2.1.1",
    "cross-env": "10.1.0",
    "eslint": "9.39.4",
    "express": "5.2.1",
    "globals": "17.5.0",
    "msw": "2.12.4",
    "orval": "7.21.0",
    "playwright": "1.57.0",
    "storybook": "10.3.6",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.1",
    "vite": "7.3.2",
    "vitest": "4.0.16",
    "vitest-browser-react": "2.0.2"
  }
}
