{
  "name": "rotom",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "ng build",
    "build:api": "orval --config ./orval.config.ts",
    "dev": "ng dev",
    "format": "eslint . --fix --report-unused-disable-directives --no-warn-ignored --max-warnings 0",
    "lint": "eslint . --report-unused-disable-directives --no-warn-ignored --max-warnings 0",
    "preview": "vite preview --outDir ./dist/browser",
    "storybook": "ng run rotom:storybook",
    "storybook:build": "ng run rotom:build-storybook",
    "storybook:preview": "vite preview --port 6103 --outDir ./storybook-static",
    "test": "ng test --coverage",
    "test:watch": "cross-env TEST_DEBUG=1 ng test --watch"
  },
  "dependencies": {
    "@angular/cdk": "21.2.9",
    "@angular/common": "21.2.11",
    "@angular/compiler": "21.2.11",
    "@angular/core": "21.2.11",
    "@angular/forms": "21.2.11",
    "@angular/platform-browser": "21.2.11",
    "@angular/router": "21.2.11",
    "@natu/styles": "workspace:^",
    "@natu/ui-angular": "workspace:^",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@analogjs/storybook-angular": "2.5.0",
    "@analogjs/vite-plugin-angular": "2.5.0",
    "@analogjs/vitest-angular": "2.5.0",
    "@angular-devkit/architect": "0.2102.9",
    "@angular-devkit/build-angular": "21.2.9",
    "@angular-devkit/core": "21.2.9",
    "@angular/animations": "21.2.11",
    "@angular/build": "21.2.9",
    "@angular/cli": "21.2.9",
    "@angular/compiler-cli": "21.2.11",
    "@angular/platform-browser-dynamic": "21.2.11",
    "@compodoc/compodoc": "1.2.1",
    "@faker-js/faker": "10.4.0",
    "@msw/data": "1.1.5",
    "@natu/axe": "workspace:^",
    "@natu/browserslist-config-shared": "workspace:^",
    "@natu/eslint-config-shared": "workspace:^",
    "@natu/orval": "workspace:^",
    "@natu/stories": "workspace:^",
    "@natu/tsconfig": "workspace:^",
    "@playwright/test": "1.59.1",
    "@storybook/addon-a11y": "10.3.6",
    "@storybook/addon-docs": "10.3.6",
    "@storybook/angular": "10.3.6",
    "@storybook/builder-vite": "10.3.6",
    "@types/node": "24.12.2",
    "@vitest/browser-playwright": "4.1.5",
    "@vitest/coverage-v8": "4.1.5",
    "cross-env": "10.1.0",
    "eslint": "10.3.0",
    "msw": "2.14.3",
    "orval": "8.9.1",
    "playwright": "1.59.1",
    "sass-embedded": "^1.99.0",
    "storybook": "10.3.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.1",
    "vite": "8.0.10",
    "vitest": "4.1.5",
    "vitest-browser-angular": "^0.4.0"
  }
}
