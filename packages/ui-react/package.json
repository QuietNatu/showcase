{
  "name": "@natu/ui-react",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./components/*": {
      "types": "./src/lib/components/*/index.ts",
      "default": "./src/lib/components/*/index.ts"
    },
    "./utils/context": {
      "types": "./src/lib/utils/context.ts",
      "default": "./src/lib/utils/context.ts"
    }
  },
  "scripts": {
    "lint": "tsc --noEmit && eslint . --report-unused-disable-directives --no-warn-ignored --max-warnings 0",
    "storybook": "storybook dev -p 6013",
    "storybook:build": "storybook build",
    "storybook:build:test": "storybook build --test",
    "storybook:preview": "http-server -c-1 ./storybook-static --silent",
    "test": "vitest run --coverage",
    "test:watch": "vitest --browser.headless=false"
  },
  "devDependencies": {
    "@base-ui/react": "catalog:",
    "@eslint/js": "catalog:",
    "@natu/axe": "workspace:^",
    "@natu/eslint-config-shared": "workspace:^",
    "@natu/stories": "workspace:^",
    "@natu/styles": "workspace:^",
    "@natu/tsconfig": "workspace:^",
    "@playwright/test": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "clsx": "catalog:",
    "cross-env": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "http-server": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sass-embedded": "catalog:",
    "storybook": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "catalog:"
  },
  "peerDependencies": {
    "@base-ui/react": "catalog:",
    "@natu/styles": "workspace:^",
    "clsx": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
